{
  "id": "timer",
  "name": "__MSG_manifest.name__",
  "version": "1.0.2",
  "type": "extension",
  "description": "__MSG_manifest.description__",
  "icon": "⏱️",
  "author": "kage",
  "permissions": [],
  "config": {
    "notify_on_complete": {
      "type": "boolean",
      "default": true
    },
    "sound_on_complete": {
      "type": "boolean",
      "default": true
    },
    "sound_id": {
      "type": "string",
      "default": "two-tone",
      "enum": [
        "two-tone",
        "chime",
        "alert",
        "gentle",
        "bell",
        "success",
        "custom"
      ]
    },
    "custom_sound_path": {
      "type": "string",
      "default": ""
    },
    "sound_repeats": {
      "type": "number",
      "default": 3
    },
    "show_window_on_complete": {
      "type": "boolean",
      "default": true
    }
  },
  "contributes": {
    "searchProvider": "./search.js",
    "settingsProvider": "./settings.js"
  },
  "tags": [
    "timer",
    "stopwatch",
    "productivity",
    "pomodoro"
  ]
}
