{
  "id": "dictionary",
  "name": "__MSG_manifest.name__",
  "version": "1.7.6",
  "type": "extension",
  "description": "__MSG_manifest.description__",
  "icon": "📖",
  "author": "kage",
  "permissions": [],
  "config": {
    "trigger": {
      "type": "string",
      "default": "dict",
      "backup": "plain"
    },
    "language": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "en",
        "la",
        "es",
        "it",
        "ru",
        "pt",
        "fr",
        "de",
        "sv",
        "fi",
        "zh",
        "pl",
        "nl",
        "ro",
        "ja",
        "el",
        "hu",
        "cs",
        "uk",
        "da",
        "bg",
        "ko",
        "tr",
        "vi",
        "hi",
        "ar",
        "th",
        "fa",
        "he",
        "id"
      ]
    },
    "show_pronunciation": {
      "type": "boolean",
      "default": true
    },
    "show_examples": {
      "type": "boolean",
      "default": true
    },
    "show_synonyms": {
      "type": "boolean",
      "default": true
    }
  },
  "contributes": {
    "searchProvider": "./search.js",
    "settingsProvider": "./settings.js",
    "css": [
      "./styles.css"
    ]
  },
  "tags": [
    "dictionary",
    "spelling",
    "definitions",
    "language",
    "words",
    "translate"
  ]
}
